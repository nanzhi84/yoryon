{
  "name": "@yoryon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "build": "tsup",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=../../.env src/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@yoryon/config": "workspace:*",
    "@yoryon/core": "workspace:*",
    "@yoryon/db": "workspace:*",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.10.6",
    "pg": "^8.16.3",
    "sharp": "0.34.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
