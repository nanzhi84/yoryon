# ===== 共享 =====
# BFF 共享密钥（仅来源标识与 IP 归因，绝不参与授权）。生产用 `openssl rand -hex 32` 生成。
BFF_SHARED_SECRET=dev-bff-secret-change-me-32bytes-min

# ===== apps/web（Next.js / Vercel）=====
# API 转发目标：本地为 http://localhost:4100；生产为公网 API 域名（Vercel 无法连 ECS 内网，统一经 Caddy 公网入口，如 https://api.example.com）
API_INTERNAL_URL=http://localhost:4100
# CSRF Origin 白名单（逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000
# 站点公网地址
SITE_URL=http://localhost:3000
# 信息流公开缓存秒数（ADR-0003）
FEED_REVALIDATE_SEC=60

# ===== apps/api（Hono / ECS）=====
PORT=4100
DATABASE_URL=postgres://postgres:postgres@localhost:54320/yoryon
# 存储后端：fs（本地/E2E）| oss（生产）
STORAGE_BACKEND=fs
FS_STORAGE_ROOT=./.storage
FS_STORAGE_SIGNING_SECRET=dev-fs-signing-secret-change-me
API_PUBLIC_URL=http://localhost:4100
MEDIA_SIGN_TTL=900
# OSS（STORAGE_BACKEND=oss 时必填）
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
# 邮件：开发用 Mailpit（docker compose dev），生产 DirectMail SMTP
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=11025
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM="Yoryon Blog <no-reply@example.com>"

# ===== apps/cli（本地，经 SSH 隧道连生产库）=====
SSH_HOST=
SSH_USER=root
SSH_PORT=22
SSH_KEY_PATH=~/.ssh/id_rsa
TUNNEL_LOCAL_PORT=55432
# 限流阈值放大倍数（默认 1；E2E 环境使用 8 避免共享 IP 桶干扰）
RATE_LIMIT_SCALE=1

# ===== 生产 compose（deploy/）必填 =====
# POSTGRES_PASSWORD=（生产数据库口令）
# API_DOMAIN=api.example.com（Caddy 监听并自动签 TLS 的 API 域名；web 的 API_INTERNAL_URL 指向 https://$API_DOMAIN）
