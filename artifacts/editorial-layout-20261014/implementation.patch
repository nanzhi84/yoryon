   overflow-wrap: anywhere;
 }
 .prose-yoryon :where(p):not(:where([class~="not-prose"] *)) {
-  margin-top: 1em;
-  margin-bottom: 1em;
+  margin-top: 0;
+  margin-bottom: 20px;
+}
+/* 书刊式阅读节奏只作用于内容，导航、付费提示与互动仍使用界面字体。 */
+.editorial-reader { max-width: 660px; margin-inline: auto; }
+.editorial-title { margin-top: 24px; margin-bottom: 40px; }
+.editorial-title h1 { font-family: var(--font-serif); font-size: clamp(25px, 5.2vw, 31px); line-height: 1.38; text-wrap: balance; }
+.editorial-entry h2, .editorial-excerpt { font-family: var(--font-serif); }
+.prose-yoryon :where(h2):not(:where([class~="not-prose"] *)) { font-size: 23px; line-height: 1.4; margin: 52px 0 18px; font-weight: 600; text-wrap: balance; }
+.prose-yoryon :where(h3):not(:where([class~="not-prose"] *)) { font-size: 20px; line-height: 1.5; margin: 36px 0 16px; text-wrap: balance; }
+.prose-yoryon :where(a):not(:where([class~="not-prose"] *)) { text-decoration-thickness: 1px; text-underline-offset: 3px; }
+.prose-yoryon :where(blockquote):not(:where([class~="not-prose"] *)) { border-left-width: 2px; border-left-color: var(--primary); font-style: normal; font-weight: 400; }
+.prose-yoryon :where(figcaption):not(:where([class~="not-prose"] *)) { font-family: var(--font-sans); font-size: 13px; line-height: 1.55; }
+.prose-yoryon .not-prose { font-family: var(--font-sans); }
+.prose-yoryon pre { border-radius: 4px; font-size: 13px; line-height: 1.6; }
+@media (max-width: 620px) {
+  .editorial-reader .prose-yoryon { font-size: 16px; }
+  .editorial-reader .prose-yoryon :where(h2):not(:where([class~="not-prose"] *)) { font-size: 21px; margin-top: 44px; }
 }
 /* 信息流条内密度独立于详情排版，保持同一字号，不按设备切换布局。 */
 .prose-feed { font-size: 15px; line-height: 24px; }
