{$API_DOMAIN} {
	# Signed authorization redirects stay private; the web byte cache has its own live gate.
	header /api/media/* >Cache-Control "private, no-store"
	reverse_proxy api:4000 {
		header_up X-Forwarded-For {remote_host}
		header_up -X-Real-Ip
	}
	encode zstd gzip
	# No access log: signed media URLs and authentication query values are sensitive.
}
