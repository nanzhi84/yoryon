{
  "name": "yoryon",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' --filter='./apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @yoryon/api dev",
    "dev:web": "pnpm --filter @yoryon/web dev",
    "cli": "pnpm --filter @yoryon/cli start",
    "db:generate": "pnpm --filter @yoryon/db generate",
    "db:migrate": "pnpm --filter @yoryon/api migrate",
    "docker:dev": "docker compose -f deploy/docker-compose.dev.yml up -d",
    "dev": "pnpm dev:web",
    "static:export": "tsx apps/cli/src/static-export/index.ts",
    "preview": "node scripts/preview-static.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6"
  },
  "packageManager": "pnpm@11.8.0"
}
